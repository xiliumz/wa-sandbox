# Webhook Configuration
VITE_WEBHOOK_URL=http://localhost:3000/webhook
VITE_VERIFY_TOKEN=your_verify_token_here
VITE_APP_SECRET=your_app_secret_here

# Real-time replies via WebSocket bridge server
VITE_WS_URL=ws://localhost:3001

# Optional: Legacy polling fallback (only used if VITE_WS_URL is empty)
VITE_BACKEND_API_URL=
VITE_POLL_INTERVAL=3000

# Simulator identity
VITE_USER_PHONE=6281234567890
VITE_BUSINESS_PHONE=15550000000

# Bridge server port (Docker Compose only)
BACKEND_PORT=4001
